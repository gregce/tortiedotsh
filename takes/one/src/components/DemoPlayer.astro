---
/**
 * The durable-session demonstration.
 * Static state: rendered poster plus caption, which is the whole story
 * with JavaScript disabled. With JavaScript, a click loads the self-hosted
 * HyperFrames player and plays the seekable composition. Under
 * prefers-reduced-motion the click loads the rendered MP4 instead.
 * Nothing here talks to any host but our own.
 */
---

<figure class="demo-breakout" id="demo">
  <div class="demo-frame" id="demo-frame">
    <img
      class="demo-poster"
      src="/demos/durable-session/poster.jpg"
      width="1280"
      height="800"
      loading="lazy"
      alt="A Tortie window. The session api-refactor is selected in the sidebar and an agent is working in the terminal."
    />
    <button class="demo-play" id="demo-play" hidden>
      <span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
          <path d="M2.5 1.1a.6.6 0 0 1 .9-.5l7.2 4.9a.6.6 0 0 1 0 1L3.4 11.4a.6.6 0 0 1-.9-.5V1.1Z"></path>
        </svg>
        Play the demonstration
      </span>
    </button>
  </div>
  <figcaption class="demo-caption">
    A session survives the app. The window closes, the window reopens, and the
    conversation is still there with its scrollback.
  </figcaption>
</figure>

<script>
  const frame = document.getElementById("demo-frame")!;
  const play = document.getElementById("demo-play") as HTMLButtonElement;
  play.hidden = false;

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  async function start() {
    play.disabled = true;
    if (reducedMotion.matches) {
      const video = document.createElement("video");
      video.src = "/demos/durable-session/durable-session.mp4";
      video.poster = "/demos/durable-session/poster.jpg";
      video.controls = true;
      video.playsInline = true;
      frame.replaceChildren(video);
      video.play().catch(() => {});
      return;
    }
    if (!customElements.get("hyperframes-player")) {
      await new Promise<void>((resolve, reject) => {
        const s = document.createElement("script");
        s.src = "/vendor/hyperframes-player.global.js";
        s.onload = () => resolve();
        s.onerror = () => reject(new Error("player failed to load"));
        document.head.appendChild(s);
      }).catch(() => {
        /* fall back to the rendered MP4 */
        const video = document.createElement("video");
        video.src = "/demos/durable-session/durable-session.mp4";
        video.controls = true;
        frame.replaceChildren(video);
        return null;
      });
      if (!customElements.get("hyperframes-player")) return;
    }
    const player = document.createElement("hyperframes-player");
    player.setAttribute("src", "/demos/durable-session/index.html");
    player.setAttribute("poster", "/demos/durable-session/poster.jpg");
    player.setAttribute("width", "1280");
    player.setAttribute("height", "800");
    player.setAttribute("controls", "");
    player.setAttribute("autoplay", "");
    frame.replaceChildren(player);
  }

  play.addEventListener("click", start);
</script>
