---
import "../../../../../assets/gmux-tokens.css";
import "../../styles/site.css";
import "../../styles/docs.css";
import DocsShell from "../../components/DocsShell.astro";
import DocsArticle from "../../components/DocsArticle.astro";
import { docsPages, type DocPage } from "../../data/docs";

export function getStaticPaths() {
  return docsPages
    .filter((page) => page.path !== "/docs/")
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: DocPage;
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} — Tortie docs</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={`https://tortie.sh${page.path}`} />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon-180.png" />
    <meta name="theme-color" content="#000000" />
  </head>
  <body class="docs-body">
    <DocsShell currentPath={page.path}>
      <DocsArticle page={page} />
    </DocsShell>
  </body>
</html>
