---
const destination = "/docs/changelog/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Changelog moved — Tortie</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href="https://tortie.sh/docs/changelog/" />
  </head>
  <body>
    <p>The Tortie changelog moved to <a href={destination}>Tortie docs</a>.</p>
  </body>
</html>
