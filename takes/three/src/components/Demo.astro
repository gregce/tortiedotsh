<section class="feature-chapter band" id="survive-quit">
  <div class="container feature-layout">
    <div class="feature-copy">
      <p class="feature-kicker">The window is disposable</p>
      <h2>Survive quit.</h2>
      <p>Close the window. Exit the app. Your sessions keep running.</p>
    </div>
    <figure class="feature-media" id="demo-stage" data-src="/demos/durable-session/index.html" data-mp4="/demos/durable-session/durable-session.mp4" data-poster="/demos/durable-session/poster.webp">
      <img id="demo-poster" src="/demos/durable-session/poster.webp" alt="A Tortie session running a coding agent before the app window is closed." width="1280" height="800" loading="lazy" />
      <figcaption>Quit the app. The session keeps working.</figcaption>
    </figure>
  </div>
</section>

<script src="/vendor/hyperframes-player.global.js" defer is:inline></script>
<script is:inline>
  (function () {
    var stage = document.getElementById("demo-stage");
    var poster = document.getElementById("demo-poster");
    if (!stage || !poster) return;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var mounted = false;
    function mount() {
      if (mounted) return;
      mounted = true;
      var el;
      if (reduced) {
        el = document.createElement("video"); el.controls = true; el.preload = "none"; el.playsInline = true;
        el.poster = stage.dataset.poster; el.src = stage.dataset.mp4;
        el.setAttribute("aria-label", "Demo video. The Tortie window closes while the session keeps running, then reopens on the same conversation.");
      } else {
        el = document.createElement("hyperframes-player"); el.setAttribute("src", stage.dataset.src);
        el.setAttribute("width", "1280"); el.setAttribute("height", "800"); el.setAttribute("controls", "");
      }
      el.className = "feature-live"; poster.replaceWith(el);
    }
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (entries) { if (entries.some(function (entry) { return entry.isIntersecting; })) { io.disconnect(); mount(); } }, { rootMargin: "600px 0px" });
      io.observe(stage);
    } else { mount(); }
  })();
</script>

<style>
  .feature-chapter { padding: clamp(64px, 9vw, 112px) 0; }
  .feature-layout { display: grid; grid-template-columns: minmax(200px, .55fr) minmax(0, 1.45fr); align-items: center; gap: clamp(40px, 7vw, 96px); }
  .feature-copy { max-width: 280px; }
  .feature-kicker { margin: 0 0 var(--space-7); color: var(--accent-text); font-size: 12px; }
  .feature-copy h2 { margin: 0; font-size: clamp(28px, 3vw, 42px); line-height: 1.08; letter-spacing: -.025em; }
  .feature-copy > p:last-child { margin: var(--space-6) 0 0; color: var(--text-secondary); line-height: 1.6; }
  .feature-media { margin: 0; }
  .feature-media img, .feature-media :global(.feature-live) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; border: 1px solid var(--border-strong); border-radius: var(--r-lg); background: var(--bg-canvas); overflow: hidden; }
  .feature-media figcaption { margin-top: var(--space-5); color: var(--text-muted); font-size: 12px; text-align: right; }
  @media (max-width: 780px) { .feature-layout { grid-template-columns: 1fr; } .feature-copy { max-width: 34ch; } }
</style>
