---
// The download section. The same two CTAs, the install line, and the
// license line.
---

<section class="download band" id="download">
  <div class="container narrow download-inner">
    <h2 class="section-title">Download</h2>
    <p class="download-install">
      Drag Tortie into Applications and point it at a project folder. Any
      folder works. A git repository gets the full sidebar.
    </p>
    <div class="download-ctas">
      <a
        class="btn btn-primary"
        href="https://github.com/gregce/tortie/releases/latest"
        >Download for macOS</a
      >
      <a class="btn btn-outline" href="https://github.com/gregce/tortie"
        >View on GitHub</a
      >
    </div>
    <p class="download-fine">Apple silicon. Free under the Apache 2.0 license.</p>
  </div>
</section>

<style>
  .download {
    padding: clamp(48px, 8vh, 88px) 0;
  }

  .download-inner {
    text-align: center;
  }

  .download-install {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto;
  }

  .download-ctas {
    display: flex;
    justify-content: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  .download-fine {
    font-size: 13px;
    color: var(--text-muted);
    margin: var(--space-5) 0 0;
  }

  @media (max-width: 480px) {
    .download-ctas {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
