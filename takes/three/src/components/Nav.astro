---
// The nav is the app's band. One bar on --bg-sidebar, one 1px hairline
// under it, both CTAs repeated small.
interface Props {
  current?: "compare" | "docs" | "changelog";
}

const { current } = Astro.props;
---

<header class="nav">
  <div class="container nav-inner">
    <a class="lockup nav-lockup" href="/" aria-label="Tortie.sh, home">
      <img src="/brand/tortie-mark-560.webp" alt="" width="26" height="26" />
      <span class="wordmark" aria-hidden="true"
        ><span class="wm-name">TORTIE</span><span class="wm-suffix">.sh</span></span
      >
    </a>
    <nav class="nav-actions nav-actions-desktop" aria-label="Primary">
      <a
        class="nav-link"
        href="/compare/"
        aria-current={current === "compare" ? "page" : undefined}
      >Compare</a>
      <a class="nav-link" href="/docs/" aria-current={current === "docs" ? "page" : undefined}>Docs</a>
      <a class="nav-link" href="/changelog/" aria-current={current === "changelog" ? "page" : undefined}>Changelog</a>
      <a class="nav-link" href="https://github.com/gregce/tortie">GitHub</a>
      <a
        class="btn btn-primary btn-small"
        href="https://github.com/gregce/tortie/releases/latest"
        >Download for macOS</a
      >
    </nav>
    <div class="nav-mobile">
      <a class="btn btn-primary btn-small" href="https://github.com/gregce/tortie/releases/latest">Download</a>
      <details class="nav-menu">
        <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
        <nav aria-label="Mobile primary">
          <a href="/compare/" aria-current={current === "compare" ? "page" : undefined}>Compare</a>
          <a href="/docs/" aria-current={current === "docs" ? "page" : undefined}>Docs</a>
          <a href="/changelog/" aria-current={current === "changelog" ? "page" : undefined}>Changelog</a>
          <a href="https://github.com/gregce/tortie">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-titlebar);
    background: var(--bg-sidebar);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }

  .nav-lockup {
    gap: 9px;
  }

  .nav-lockup .wordmark {
    font-size: 16px;
  }

  .nav-lockup img {
    display: block;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 var(--space-5);
    color: var(--text-secondary);
    font-size: 13px;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--text-primary);
  }

  .nav-mobile { display: none; }
  .nav-menu { position: relative; }
  .nav-menu summary {
    display: grid; align-content: center; gap: 4px; width: 32px; height: 32px;
    padding: 7px; border: 1px solid var(--border-strong); border-radius: var(--r-md);
    cursor: pointer; list-style: none;
  }
  .nav-menu summary::-webkit-details-marker { display: none; }
  .nav-menu summary span { display: block; height: 1px; background: var(--text-secondary); }
  .nav-menu nav {
    position: absolute; top: 38px; right: 0; display: grid; min-width: 168px;
    padding: var(--space-3); border: 1px solid var(--border-strong);
    border-radius: var(--r-md); background: var(--bg-surface); box-shadow: var(--shadow-2);
  }
  .nav-menu nav a { padding: 9px 10px; color: var(--text-secondary); font-size: 13px; }
  .nav-menu nav a:hover, .nav-menu nav a[aria-current="page"] { color: var(--text-primary); background: var(--bg-raised); }

  @media (max-width: 760px) {
    .nav-actions-desktop { display: none; }
    .nav-mobile { display: flex; align-items: center; gap: var(--space-4); }
  }

  @media (max-width: 390px) {
    .nav-lockup .wordmark { display: none; }
  }
</style>
