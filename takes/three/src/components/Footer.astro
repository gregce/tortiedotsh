---
// The footer. A small lockup and the three places a visitor may still
// want to go.
---

<footer class="footer">
  <div class="container footer-inner">
    <a class="lockup footer-lockup" href="/" aria-label="Tortie.sh, home">
      <img src="/brand/tortie-mark-560.webp" alt="" width="22" height="22" />
      <span class="wordmark" aria-hidden="true"
        ><span class="wm-name">TORTIE</span><span class="wm-suffix">.sh</span></span
      >
    </a>
    <nav class="footer-links" aria-label="Footer">
      <a href="https://github.com/gregce/tortie">GitHub</a>
      <a href="https://github.com/gregce/tortie/releases/latest">Releases</a>
      <a href="https://github.com/gregce/tortie/blob/main/LICENSE"
        >Apache 2.0 license</a
      >
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-9) 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer-lockup {
    gap: 7px;
  }

  .footer-lockup .wordmark {
    font-size: 14px;
  }

  .footer-lockup img {
    display: block;
  }

  .footer-links {
    display: flex;
    gap: var(--space-8);
    font-size: 13px;
  }

  .footer-links a {
    color: var(--text-secondary);
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }
</style>
