---
import changelog from "../data/changelog.json";
const latest = changelog.releases[0];
const destinations = [
  { title: "Compare", copy: "See where Tortie fits in the broader ecosystem. Learn what other tools do, too.", href: "/compare/agent-multiplexers/", action: "Explore comparisons" },
  { title: "Docs", copy: "Learn the concepts, shortcuts, and recovery model.", href: "/docs/", action: "Read the docs" },
  { title: "Changelog", copy: `Latest release: ${latest.version} · ${latest.date}.`, href: "/docs/changelog/", action: "See what’s new" },
];
---

<section class="destinations" aria-label="Explore Tortie"><div class="container destination-grid">
  {destinations.map((destination) => <article><h2>{destination.title}</h2><p>{destination.copy}</p><a href={destination.href}>{destination.action} <span aria-hidden="true">→</span></a></article>)}
</div></section>

<style>
  .destinations { border-bottom: 1px solid var(--border); }
  .destination-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .destination-grid article { min-width: 0; padding: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 48px); border-right: 1px solid var(--border); }
  .destination-grid article:first-child { padding-left: 0; }
  .destination-grid article:last-child { padding-right: 0; border-right: 0; }
  .destination-grid h2 { margin: 0; font-size: 18px; line-height: 1.3; }
  .destination-grid p { min-height: 3.2em; margin: var(--space-5) 0 var(--space-7); color: var(--text-secondary); font-size: 14px; line-height: 1.6; }
  .destination-grid a { font-size: 13px; }
  @media (max-width: 720px) { .destination-grid { grid-template-columns: 1fr; } .destination-grid article, .destination-grid article:first-child, .destination-grid article:last-child { padding: 32px 0; border-right: 0; border-bottom: 1px solid var(--border); } .destination-grid article:last-child { border-bottom: 0; } .destination-grid p { min-height: 0; } }
</style>
