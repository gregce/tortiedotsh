---
// Replace this image with a muted, looped 16:9 product film after capture.
// Keep the WebP as its poster and reduced-motion fallback so layout never shifts.
---

<section class="hero">
  <div class="container hero-layout">
    <div class="hero-copy">
      <h1>Your work<br />continues.</h1>
      <p>Tortie keeps coding-agent sessions alive, organized, and ready when you return.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="https://github.com/gregce/tortie/releases/latest"><span aria-hidden="true">↓</span> Download for macOS</a>
      </div>
      <p class="hero-meta">macOS 13+ <span aria-hidden="true">·</span> Apple silicon &amp; Intel</p>
    </div>
    <figure class="hero-stage">
      <img src="/marketing/hero-cinematic.webp" alt="Illustrative Tortie product window showing several coding-agent sessions arranged in one project." width="1600" height="901" fetchpriority="high" />
      <figcaption>Product film preview</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { min-height: min(760px, calc(100svh - 52px)); display: grid; align-items: center; padding: clamp(64px, 10vh, 112px) 0; overflow: hidden; border-bottom: 1px solid var(--border); }
  .hero-layout { display: grid; grid-template-columns: minmax(250px, .72fr) minmax(520px, 1.55fr); align-items: center; gap: clamp(40px, 6vw, 88px); }
  .hero-copy { position: relative; z-index: 1; }
  .hero-copy h1 { max-width: 8ch; margin: 0; font-size: clamp(44px, 5vw, 72px); font-weight: var(--weight-semibold); line-height: 1.02; letter-spacing: -.035em; text-wrap: balance; }
  .hero-copy > p:first-of-type { max-width: 33ch; margin: var(--space-8) 0 0; color: var(--text-secondary); font-size: 17px; line-height: 1.55; }
  .hero-actions { margin-top: var(--space-9); }
  .hero-actions .btn { gap: var(--space-5); }
  .hero-meta { margin: var(--space-5) 0 0; color: var(--text-muted); font-size: 12px; }
  .hero-stage { position: relative; width: min(74vw, 900px); margin: 0; animation: stage-reveal 700ms var(--ease-out) both; }
  .hero-stage::after { content: ""; position: absolute; inset: auto 7% -20px; height: 28px; background: rgba(0,0,0,.42); filter: blur(18px); z-index: -1; }
  .hero-stage img { display: block; width: 100%; height: auto; border: 1px solid var(--border-strong); border-radius: var(--r-lg); background: var(--bg-surface); box-shadow: var(--shadow-3); }
  .hero-stage figcaption { margin-top: var(--space-4); color: var(--text-muted); font-size: 11px; text-align: right; }
  @keyframes stage-reveal { from { clip-path: inset(0 0 100% 0); filter: blur(8px); } to { clip-path: inset(0); filter: blur(0); } }
  @media (max-width: 1020px) { .hero { min-height: auto; } .hero-layout { grid-template-columns: 1fr; } .hero-stage { width: 100%; } .hero-copy h1 { max-width: 10ch; } }
  @media (max-width: 520px) { .hero-actions .btn { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero-stage { animation: none; } }
</style>
