---
// A section header drawn as the app's session tab strip: the 36px band with
// one active tab. The tab shows a name and a status dot, exactly the anatomy
// of a session tab in Tortie. Amber never appears here.
interface Props {
  name: string;
  dot?: "working" | "idle";
  glyph?: boolean;
  heading?: boolean;
  id?: string;
}
const { name, dot = "idle", glyph = false, heading = true, id } = Astro.props;
---
<div class="session-strip" id={id}>
  <div class="session-tab">
    {glyph && <span class="agent-glyph" aria-hidden="true">&#10095;</span>}
    {heading ? <h2>{name}</h2> : <span>{name}</span>}
    <span class={`dot dot-${dot}`} aria-hidden="true"></span>
  </div>
</div>
