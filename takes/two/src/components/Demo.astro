---
// The value demonstration. One HyperFrames composition, played seekable in
// the page. Scrolling advances the scene. With reduced motion it becomes the
// rendered MP4. With JavaScript off it stays the rendered poster.
import SessionStrip from "./SessionStrip.astro";
---
<section class="demo-scroll" id="demo">
  <div class="demo-sticky">
    <SessionStrip name="claude-1" dot="working" glyph heading={false} />
    <div class="demo-stage" id="demo-stage" data-mp4="/demos/durable-session/durable-session.mp4">
      <img
        src="/demos/durable-session/poster.png"
        width="960"
        height="600"
        alt="A Tortie window. The session claude-1 is working and its status dot is blue."
        loading="lazy"
      />
    </div>
    <p class="demo-caption" id="demo-caption">
      The window closes and the session keeps running. The window comes back to the same conversation.
    </p>
  </div>
</section>

<script>
  import "@hyperframes/player";

  type PlayerEl = HTMLElement & {
    ready: boolean;
    paused: boolean;
    duration: number;
    seek: (t: number) => void;
  };

  const section = document.getElementById("demo")!;
  const stage = document.getElementById("demo-stage")!;
  const caption = document.getElementById("demo-caption")!;
  const mp4 = stage.dataset.mp4!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduced) {
    // No animation. The rendered MP4 with plain controls, never autoplay.
    const video = document.createElement("video");
    video.controls = true;
    video.preload = "none";
    video.poster = "/demos/durable-session/poster.png";
    video.src = mp4;
    video.width = 960;
    video.height = 600;
    stage.replaceChildren(video);
  } else {
    // Build the player only when the section approaches the viewport.
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        mount();
      },
      { rootMargin: "600px" },
    );
    io.observe(section);

    function mount() {
      const player = document.createElement("hyperframes-player") as PlayerEl;
      player.setAttribute("src", "/demos/durable-session/index.html");
      player.setAttribute("poster", "/demos/durable-session/poster.png");
      player.setAttribute("width", "960");
      player.setAttribute("height", "600");
      player.setAttribute("controls", "");
      player.setAttribute("muted", "");
      stage.replaceChildren(player);
      section.classList.add("enhanced");
      caption.textContent = "Scroll to move through the scene, or press play.";

      // Scroll drives the timeline while the player is paused.
      let scrubbing = true;
      let raf = 0;
      player.addEventListener("play", () => (scrubbing = false));
      player.addEventListener("pause", () => (scrubbing = true));
      player.addEventListener("ready", () => {
        // Seek to the scroll position, then drop the poster. The player only
        // removes its poster on play(), and this demo is scrubbed, not played.
        seekToScroll();
        player.removeAttribute("poster");
      });

      function seekToScroll() {
        raf = 0;
        if (!scrubbing || !player.ready) return;
        const rect = section.getBoundingClientRect();
        const range = rect.height - window.innerHeight;
        if (range <= 0) return;
        const progress = Math.min(1, Math.max(0, -rect.top / range));
        player.seek(progress * player.duration);
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!raf) raf = requestAnimationFrame(seekToScroll);
        },
        { passive: true },
      );
    }
  }
</script>
