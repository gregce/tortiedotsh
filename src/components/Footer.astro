---
// The footer. A small lockup and the three places a visitor may still
// want to go.
import GitHubMark from "./GitHubMark.astro";
import openSourceMetrics from "../data/open-source-metrics.json";
import { TORTIE_REPOSITORY_URL } from "../data/site-links";

const tortieMetrics = openSourceMetrics.projects.find((project) => project.id === "tortie");
const githubStars = typeof tortieMetrics?.stars === "number" ? tortieMetrics.stars : null;
const githubStarsLabel = githubStars === null
  ? null
  : new Intl.NumberFormat("en-US", {
      notation: githubStars >= 1_000 ? "compact" : "standard",
      maximumFractionDigits: 1,
    }).format(githubStars).toLowerCase();
const githubAriaLabel = githubStars === null
  ? "Tortie on GitHub"
  : `Tortie on GitHub, ${githubStars.toLocaleString("en-US")} ${githubStars === 1 ? "star" : "stars"}`;
---

<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Footer">
      <a href="/compare/agent-multiplexers/">Compare</a>
      <a href="/docs/">Docs</a>
      <a href="/docs/changelog/">Changelog</a>
      <a class="footer-github" href={TORTIE_REPOSITORY_URL} aria-label={githubAriaLabel} title={githubAriaLabel}>
        <GitHubMark />
        {githubStarsLabel && <span aria-hidden="true">{githubStarsLabel}</span>}
      </a>
      <a href="https://github.com/gregce/tortie/blob/main/LICENSE"
        >License</a
      >
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-9) 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    font-size: 13px;
  }

  .footer-links a {
    color: var(--text-secondary);
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-github {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-variant-numeric: tabular-nums;
  }

  .footer-github :global(.github-mark) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 560px) {
    .footer-inner { align-items: flex-start; }
    .footer-links { display: grid; grid-template-columns: 1fr 1fr; width: 100%; gap: var(--space-5) var(--space-9); }
  }
</style>
