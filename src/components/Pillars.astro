---
const features = [
  { id: "restore-conversation", kicker: "Return without reconstruction", title: "Resume the conversation.", copy: "Come back later. Tortie reconnects each agent to its own conversation, not just an empty shell.", caption: "Return to the thread exactly where you left it.", art: "05-restore-conversation-square", width: 1254, height: 1254, alt: "Pixel art of Tortie watching a blue forest trail relight and return an agent to its waiting place." },
  { id: "one-project-window", kicker: "Every thread has a place", title: "One project window.", copy: "Sessions, files, changes, diffs, and search stay scoped to the project in front of you.", caption: "The whole project stays one coherent workspace.", art: "03-one-project-window-wide", width: 1672, height: 941, alt: "Pixel art of Tortie overlooking several agent paths gathered into one calm workspace." },
  { id: "needs-you", kicker: "Protect human attention", title: "Jump to what needs you.", copy: "Working agents stay quiet. Press ⌘J to move straight to the session waiting for your input.", caption: "A question rises. Everything else keeps moving.", art: "04-what-needs-you-square", width: 1254, height: 1254, alt: "Pixel art of Tortie noticing one amber signal among quiet blue agent lights." },
];
---

<section class="feature-series" aria-label="Tortie features">
  {features.map((feature, index) => (
    <article class:list={["feature-chapter", { "feature-chapter-alt": index % 2 === 1 }]} id={feature.id}>
      <div class="container feature-layout">
        <div class="feature-copy"><p class="feature-kicker">{feature.kicker}</p><h2>{feature.title}</h2><p>{feature.copy}</p></div>
        <figure class="feature-media" data-capture-slot={feature.id}>
          <picture>
            <source srcset={`/illustrations/pixel-tortie/${feature.art}.avif`} type="image/avif" />
            <img src={`/illustrations/pixel-tortie/${feature.art}.webp`} alt={feature.alt} width={feature.width} height={feature.height} loading="lazy" decoding="async" />
          </picture>
          <figcaption>{feature.caption}</figcaption>
        </figure>
      </div>
    </article>
  ))}
</section>

<style>
  .feature-chapter { padding: clamp(36px, 4vw, 56px) 0; border-bottom: 1px solid var(--border); }
  .feature-chapter-alt { background: var(--bg-sidebar); }
  .feature-layout { display: grid; grid-template-columns: minmax(200px, .55fr) minmax(0, 1.45fr); align-items: center; gap: clamp(40px, 7vw, 96px); }
  .feature-copy { max-width: 290px; }
  .feature-kicker { margin: 0 0 var(--space-7); color: var(--accent-text); font-size: 12px; }
  .feature-copy h2 { margin: 0; font-size: clamp(28px, 3vw, 42px); font-weight: var(--weight-semibold); line-height: 1.08; letter-spacing: -.025em; text-wrap: balance; }
  .feature-copy > p:last-child { margin: var(--space-6) 0 0; color: var(--text-secondary); line-height: 1.6; }
  .feature-media { margin: 0; }
  .feature-media picture { display: block; overflow: hidden; border: 1px solid var(--border-strong); border-radius: var(--r-lg); background: var(--bg-marketing); }
  .feature-media img { display: block; width: 100%; height: clamp(210px, 24vw, 300px); object-fit: cover; }
  .feature-media figcaption { margin-top: var(--space-5); color: var(--text-muted); font-size: 12px; text-align: right; }
  @media (max-width: 780px) { .feature-layout { grid-template-columns: 1fr; } .feature-copy { max-width: 34ch; } .feature-media img { height: clamp(190px, 56vw, 260px); } }
</style>
