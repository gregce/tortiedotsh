---
const features = [
  {
    id: "one-project-window",
    kicker: "Every thread has a place",
    title: "One project window.",
    copy: "Sessions, files, changes, diffs, and search stay scoped to the project in front of you.",
    caption: "The whole project stays one coherent workspace.",
    art: "03-one-project-window-wide",
    width: 960,
    height: 588,
    alt: "Tortie showing several coding-agent sessions inside one project window.",
    video: {
      webm: "/demos/one-project-window/one-project-window.webm",
      mp4: "/demos/one-project-window/one-project-window.mp4",
      poster: "/demos/one-project-window/poster.webp",
    },
  },
  {
    id: "intuitive-multiplexing",
    kicker: "The window is disposable",
    title: "Intuitive multiplexing.",
    copy: "Close the window. Exit the app. Your sessions keep running in a private tmux server, separate from the app window.",
    caption: "Tortie's app chrome is a view. Not your terminal's owner.",
    art: "03-one-project-window-wide",
    width: 960,
    height: 588,
    alt: "Tortie switching among several coding-agent sessions from one session rail.",
    video: {
      webm: "/demos/intuitive-multiplexing/intuitive-multiplexing.webm",
      mp4: "/demos/intuitive-multiplexing/intuitive-multiplexing.mp4",
      poster: "/demos/intuitive-multiplexing/poster.webp",
    },
  },
  {
    id: "restore-conversation",
    kicker: "Return without reconstruction",
    title: "Resume the conversation.",
    copy: "Come back later. Tortie reconnects each agent to its own conversation, not just an empty shell.",
    caption: "Return to the thread exactly where you left it.",
    art: "05-restore-conversation-square",
    width: 960,
    height: 606,
    alt: "Tortie restoring a coding-agent conversation in its original project session.",
    video: {
      webm: "/demos/resume-conversation/resume-conversation.webm",
      mp4: "/demos/resume-conversation/resume-conversation.mp4",
      poster: "/demos/resume-conversation/poster.webp",
    },
  },
  {
    id: "needs-you",
    kicker: "Protect your attention",
    title: "Jump to what needs you.",
    copy: "Working agents stay quiet. Press ⌘J to move straight to the session waiting for your input.",
    caption: "A question rises. Everything else keeps moving.",
    art: "04-what-needs-you-square",
    width: 960,
    height: 584,
    alt: "Tortie raises a notification, then jumps to the coding-agent session waiting for input.",
    video: {
      webm: "/demos/notifications/notifications.webm",
      mp4: "/demos/notifications/notifications.mp4",
      poster: "/demos/notifications/poster.webp",
    },
  },
  {
    id: "catch-me-up",
    kicker: "Return without rereading",
    title: "Catch Me Up.",
    copy: "See every session in a project at a glance. Open one to read your asks and the agent's closing answers, then jump straight back to any exchange.",
    caption: "A summary line per session. A clean read of your conversation when you need it.",
    art: "04-what-needs-you-square",
    width: 960,
    height: 606,
    alt: "Tortie opening a project-wide Catch Me Up overview, then reviewing one coding-agent session exchange by exchange.",
    video: {
      webm: "/demos/catch-me-up/catch-me-up.webm",
      mp4: "/demos/catch-me-up/catch-me-up.mp4",
      poster: "/demos/catch-me-up/poster.webp",
    },
  },
];
---

<section class="feature-series" aria-label="Tortie features">
  {features.map((feature, index) => (
    <article class:list={["feature-chapter", { "feature-chapter-alt": index % 2 === 1 }]} id={feature.id}>
      <div class="container feature-layout">
        <div class="feature-copy"><p class="feature-kicker">{feature.kicker}</p><h2>{feature.title}</h2><p>{feature.copy}</p></div>
        <figure class="feature-media" data-capture-slot={feature.id}>
          {feature.video ? (
            <video
              data-feature-video
              muted
              loop
              playsinline
              preload="none"
              poster={feature.video.poster}
              width={feature.width}
              height={feature.height}
              style={`aspect-ratio: ${feature.width} / ${feature.height};`}
              aria-label={feature.alt}
            >
              <source src={feature.video.webm} type="video/webm" />
              <source src={feature.video.mp4} type="video/mp4" />
            </video>
          ) : (
            <picture>
              <source srcset={`/illustrations/pixel-tortie/${feature.art}.avif`} type="image/avif" />
              <img src={`/illustrations/pixel-tortie/${feature.art}.webp`} alt={feature.alt} width={feature.width} height={feature.height} loading="lazy" decoding="async" />
            </picture>
          )}
          <figcaption>{feature.caption}</figcaption>
        </figure>
      </div>
    </article>
  ))}
</section>

<script is:inline>
  (function () {
    function initFeatureVideos() {
      document.querySelectorAll("[data-feature-video]").forEach(function (video) {
        if (video.dataset.playbackReady === "true") return;
        video.dataset.playbackReady = "true";

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        var observer;
        function play() {
          video.preload = "auto";
          video.play().catch(function () {});
        }

        if ("IntersectionObserver" in window) {
          observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) play();
              else video.pause();
            });
          }, { rootMargin: "400px 0px" });
          observer.observe(video);
        } else {
          play();
        }

        document.addEventListener("astro:before-swap", function () {
          if (observer) observer.disconnect();
          video.pause();
        }, { once: true });
      });
    }

    initFeatureVideos();
    document.addEventListener("astro:page-load", initFeatureVideos);
  })();
</script>

<style>
  .feature-chapter { padding: clamp(36px, 4vw, 56px) 0; }
  .feature-chapter-alt { background: var(--bg-sidebar); }
  .feature-layout { display: grid; grid-template-columns: minmax(200px, .55fr) minmax(0, 1.45fr); align-items: center; gap: clamp(40px, 7vw, 96px); }
  .feature-chapter-alt .feature-layout { grid-template-columns: minmax(0, 1.45fr) minmax(200px, .55fr); }
  .feature-chapter-alt .feature-copy { grid-column: 2; grid-row: 1; }
  .feature-chapter-alt .feature-media { grid-column: 1; grid-row: 1; }
  .feature-copy { max-width: 290px; }
  .feature-kicker { margin: 0 0 var(--space-7); color: var(--accent-text); font-size: 12px; }
  .feature-copy h2 { margin: 0; font-size: clamp(28px, 3vw, 42px); font-weight: var(--weight-semibold); line-height: 1.08; letter-spacing: -.025em; text-wrap: balance; }
  .feature-copy > p:last-child { margin: var(--space-6) 0 0; color: var(--text-secondary); line-height: 1.6; }
  .feature-media { margin: 0; }
  .feature-media picture, .feature-media video { display: block; overflow: hidden; border: 1px solid var(--border-strong); border-radius: var(--r-lg); background: var(--bg-marketing); }
  .feature-media img { display: block; width: 100%; height: clamp(210px, 24vw, 300px); object-fit: cover; object-position: center; }
  .feature-media video { width: 100%; height: auto; object-fit: contain; }
  .feature-media figcaption { margin-top: var(--space-5); color: var(--text-muted); font-size: 12px; text-align: right; }
  @media (max-width: 780px) { .feature-layout, .feature-chapter-alt .feature-layout { grid-template-columns: 1fr; } .feature-chapter-alt .feature-copy, .feature-chapter-alt .feature-media { grid-column: auto; grid-row: auto; } .feature-copy { max-width: 34ch; } .feature-media img { height: clamp(190px, 56vw, 260px); } }
</style>
