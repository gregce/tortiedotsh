---
import AppleMark from "./AppleMark.astro";
import { TORTIE_MACOS_DOWNLOAD_URL } from "../data/site-links";
---

<section class="download" id="download">
  <picture class="download-art" aria-hidden="true">
    <source srcset="/illustrations/pixel-tortie/09-open-source-grove-wide.avif" type="image/avif" />
    <img src="/illustrations/pixel-tortie/09-open-source-grove-wide.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
  </picture>
  <div class="container download-layout">
    <div class="download-copy"><h2>Open source.<br />Built for real work.</h2><p>Free under the Apache 2.0 license and built in public.</p></div>
    <div class="download-actions">
      <div class="download-action"><a class="btn btn-primary" href={TORTIE_MACOS_DOWNLOAD_URL}><AppleMark /> Download for macOS</a><p>macOS 15.7.9 or later · Apple silicon</p></div>
    </div>
  </div>
</section>

<style>
  .download { position: relative; isolation: isolate; overflow: hidden; padding: clamp(64px, 8vw, 96px) 0 clamp(48px, 6vw, 72px); }
  .download::after { position: absolute; z-index: -1; inset: 0; background: var(--bg-marketing); content: ""; opacity: .62; }
  .download-art { position: absolute; z-index: -2; inset: 0; }
  .download-art img { width: 100%; height: 100%; object-fit: cover; object-position: center 54%; }
  .download-layout { display: grid; grid-template-columns: minmax(0, 600px); justify-content: end; gap: clamp(36px, 5vw, 56px); }
  .download-actions { display: flex; align-items: flex-start; justify-content: flex-start; gap: var(--space-10); }
  .download h2 { margin: 0; font-size: clamp(28px, 3.5vw, 46px); line-height: 1.06; letter-spacing: -.025em; }
  .download p { max-width: 42ch; margin: var(--space-6) 0 0; color: var(--text-secondary); }
  .download-action { text-align: center; }
  .download-action .btn { gap: var(--space-5); }
  .download-action p { margin: var(--space-5) 0 0; color: var(--text-muted); font-size: 12px; }
  @media (max-width: 720px) { .download { padding-block: 56px 48px; } .download::after { opacity: .72; } .download-layout { grid-template-columns: minmax(0, 1fr); justify-content: stretch; gap: var(--space-9); } .download-actions { flex-direction: column; gap: var(--space-7); } .download-action, .download-action .btn { width: 100%; } }
</style>
