---
import AppleMark from "./AppleMark.astro";
import { TORTIE_MACOS_DOWNLOAD_URL, TORTIE_REPOSITORY_URL } from "../data/site-links";
---

<section class="download" id="download">
  <div class="container download-layout">
    <div class="download-copy"><h2>Open source.<br />Built for real work.</h2><p>Tortie is free under the Apache 2.0 license and built in public.</p></div>
    <div class="download-actions">
      <a class="btn btn-outline download-github" href={TORTIE_REPOSITORY_URL}>Star on GitHub</a>
      <div class="download-action"><a class="btn btn-primary" href={TORTIE_MACOS_DOWNLOAD_URL}><AppleMark /> Download for macOS</a><p>macOS 15.7.9 or later · Apple silicon</p></div>
    </div>
  </div>
</section>

<style>
  .download { padding: clamp(56px, 7vw, 80px) 0 clamp(36px, 4vw, 48px); }
  .download-layout { display: grid; gap: var(--space-9); }
  .download-actions { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-10); }
  .download h2 { margin: 0; font-size: clamp(28px, 3.5vw, 46px); line-height: 1.06; letter-spacing: -.025em; }
  .download p { max-width: 42ch; margin: var(--space-6) 0 0; color: var(--text-secondary); }
  .download-action { text-align: center; }
  .download-action .btn { gap: var(--space-5); }
  .download-action p { margin: var(--space-5) 0 0; color: var(--text-muted); font-size: 12px; }
  @media (max-width: 720px) { .download-actions { flex-direction: column; gap: var(--space-7); } .download-github, .download-action, .download-action .btn { width: 100%; } }
</style>
