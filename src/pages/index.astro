---
/**
 * THESIS: The work lives beyond the window; refuse the generic centered hero with a screenshot card beneath it.
 * OWN-WORLD: A matte graphite studio, one real product window, 1px hairlines, blue action, and amber only for attention.
 * STORY: Learn that closing Tortie is safe, see four concrete proofs, choose a deeper destination, then download.
 * FIRST VIEWPORT: Compact navigation, a short left-aligned promise, one macOS action, and a broad product-film stage.
 * FORM: The user-selected Disposable Window concept, mock 04; wide film staging from seed a5903903.
 */
import { TORTIE_MACOS_DOWNLOAD_URL, TORTIE_REPOSITORY_URL } from "../data/site-links";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Demo from "../components/Demo.astro";
import Pillars from "../components/Pillars.astro";
import Destinations from "../components/Destinations.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";

const description =
  "A calm agent multiplexer with familiar IDE features. Keep coding-agent sessions across projects in one window, even after Tortie quits.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tortie",
  url: "https://tortie.sh/",
  description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 15.7.9 or later",
  softwareRequirements: "Apple silicon Mac running macOS 15.7.9 or later",
  downloadUrl: TORTIE_MACOS_DOWNLOAD_URL,
  sameAs: TORTIE_REPOSITORY_URL,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  image: "https://tortie.sh/og/tortie-og.png",
};
---

<BaseLayout title="Tortie | One window for every coding agent" description={description} canonicalPath="/">
    <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script></Fragment>
    <Nav overlay />
    <main>
      <Hero />
      <div class="home-after-fold">
        <Demo />
        <Pillars />
        <Destinations />
        <Download />
      </div>
    </main>
    <div class="home-footer"><Footer /></div>
</BaseLayout>

<style>
  .home-after-fold,
  .home-footer {
    --bg-canvas: var(--bg-marketing);
    --bg-sidebar: var(--bg-marketing);
    background: var(--bg-marketing);
  }
</style>
